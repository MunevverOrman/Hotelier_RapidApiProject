@model List<StaffViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Personel Adı</th>
        <th>Personel Unvan</th>
        <th>Sil</th>
        <th>Güncelle</th>
        <th>Detaylar</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <th>@item.StaffID</th>
            <td>@item.Name</td>
            <td>@item.Title</td>
            <td>
                <a href="/Staff/DeleteStaff/@item.StaffID" class="btn mb-1 btn-rounded btn-success">Sil</a>
            </td>
            <td>
                <a href="/Staff/UpdateStaff/@item.StaffID" class="btn mb-1 btn-rounded btn-warning">Güncelle</a>
            </td>
            <td>
                <a href="/Staff/DetailStaff/" class="btn mb-1 btn-rounded btn-danger">Detaylar</a>
            </td>
        </tr>
    }
</table>
<a href="/Staff/AddStaff/" class="btn btn-info">Yeni Personel Girişi</a>
